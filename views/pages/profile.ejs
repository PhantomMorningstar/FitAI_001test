<%- include('../partials/head', { pageTitle: 'Hồ sơ' }) %>
<body>
    <%- include('../partials/skip-link', { targetId: 'main-content' }) %>
    <div id="profile-page" class="app-container">
        <%- include('../partials/app-header') %>
        <main class="app-main-content" id="main-content" tabindex="-1">
            <div class="content-max-width">
                <div class="page-header">
                    <h1>Hồ sơ</h1>
                    <p class="subtitle">Quản lý tài khoản và thông tin sức khỏe cá nhân.</p>
                </div>

                <section id="auth-container" class="section-card">
                    <h3>Đăng nhập hoặc tạo tài khoản</h3>
                    <p class="subtitle" style="margin-bottom:18px;">Đăng nhập để lưu hồ sơ, bữa ăn và tiến độ an toàn trên nhiều thiết bị.</p>
                    <div class="input-field"><label for="auth-email">Địa chỉ email</label><input type="email" id="auth-email" autocomplete="email" placeholder="name@example.com"></div>
                    <div class="input-field"><label for="auth-password">Mật khẩu</label><input type="password" id="auth-password" autocomplete="current-password" placeholder="Nhập mật khẩu"></div>
                    <div style="display:flex; gap:10px; margin-top:15px; flex-wrap:wrap;">
                        <button type="button" class="btn btn-primary" id="btn-login" style="flex:1;">Đăng nhập</button>
                        <button type="button" class="btn btn-secondary" id="btn-signup" style="flex:1;">Tạo tài khoản</button>
                    </div>
                    <button type="button" class="btn btn-link reset-password-btn" data-email-input="auth-email" data-status-output="profile-reset-status">Quên mật khẩu?</button>
                    <p id="profile-reset-status" class="auth-feedback" role="status" aria-live="polite" hidden></p>
                    <p class="subtitle">Chưa có tài khoản? Chọn “Tạo tài khoản”. Đã đăng ký? Chọn “Đăng nhập”.</p>
                </section>

                <div id="authenticated-profile-container" style="display:none; flex-direction:column; gap:20px;">
                    <section id="settings-panel" class="section-card" style="display:none; border-style:dashed; border-color:var(--primary-color);">
                        <div style="display:flex; justify-content:space-between; align-items:center; gap:12px; margin-bottom:15px; flex-wrap:wrap;">
                            <h4><i class="fa-solid fa-sliders"></i> Tùy chọn</h4>
                            <button class="btn" id="btn-logout" style="background:#fff0f0; color:#b83030;">Đăng xuất</button>
                        </div>
                        <p id="account-verification-status" class="subtitle"></p>
                        <button type="button" class="btn btn-secondary" id="resend-verification-btn" hidden>Gửi lại email xác minh</button>
                        <p id="verification-action-status" class="auth-feedback" role="status" aria-live="polite" hidden></p>
                    </section>

                    <section class="section-card">
                        <h3><i class="fa-regular fa-id-card"></i> Hồ sơ cá nhân</h3>
                        <div class="profile-stats-grid" style="margin-top:15px;">
                            <div class="p-stat-item"><strong>Giới tính:</strong> <span id="prof-gender">-</span></div>
                            <div class="p-stat-item"><strong>Chiều cao:</strong> <span id="prof-height">-</span> cm</div>
                            <div class="p-stat-item"><strong>Cân nặng:</strong> <span id="prof-weight">-</span> kg</div>
                            <div class="p-stat-item"><strong>Mục tiêu:</strong> <span id="prof-goal">-</span></div>
                        </div>
                    </section>

                    <section class="section-card" id="reminder-settings-section">
                        <h3><i class="fa-solid fa-bell"></i> Thông báo và nhắc nhở</h3>
                        <p class="subtitle">FitAI kiểm tra thói quen hôm nay trước khi nhắc. Đây là thông báo cục bộ miễn phí của PWA, không cần dịch vụ gửi tin trả phí.</p>
                        <div class="reminder-permission-row">
                            <button type="button" class="btn btn-secondary" id="enable-browser-notifications">Bật thông báo trình duyệt</button>
                            <button type="button" class="btn btn-secondary" id="test-browser-notification">Gửi thông báo thử</button>
                            <span id="notification-permission-status">Chưa yêu cầu quyền</span>
                        </div>
                        <div class="notification-readiness" aria-label="Trạng thái thông báo">
                            <span id="notification-secure-status">Đang kiểm tra kết nối an toàn…</span>
                            <span id="notification-worker-status">Đang kiểm tra PWA…</span>
                        </div>
                        <p id="test-notification-status" class="auth-feedback" role="status" aria-live="polite"></p>
                        <form id="reminder-settings-form">
                            <label class="reminder-master-toggle"><input type="checkbox" id="reminders-enabled"> Bật nhắc nhở</label>
                            <div class="reminder-settings-grid">
                                <label><span><input type="checkbox" id="reminder-meal-enabled"> Nhật ký thực phẩm</span><input type="time" id="reminder-meal-time" value="20:00" aria-label="Giờ nhắc nhật ký thực phẩm"></label>
                                <label><span><input type="checkbox" id="reminder-weight-enabled"> Cân nặng</span><input type="time" id="reminder-weight-time" value="08:00" aria-label="Giờ nhắc cân nặng"></label>
                                <label><span><input type="checkbox" id="reminder-activity-enabled"> Vận động</span><input type="time" id="reminder-activity-time" value="20:30" aria-label="Giờ nhắc vận động"></label>
                                <label><span><input type="checkbox" id="reminder-wellness-enabled"> Giấc ngủ và stress</span><input type="time" id="reminder-wellness-time" value="21:00" aria-label="Giờ nhắc giấc ngủ và stress"></label>
                            </div>
                            <button type="submit" class="btn btn-primary" id="save-reminder-settings">Lưu nhắc nhở</button>
                        </form>
                        <p id="reminder-settings-status" class="auth-feedback" role="status" aria-live="polite"></p>
                        <p class="subtitle reminder-limit-note">Lịch nhắc được kiểm tra khi FitAI/PWA đang chạy hoặc được mở lại. Nếu trình duyệt bị đóng hoàn toàn, hệ điều hành có thể trì hoãn nhắc; nhận push bảo đảm khi app đã đóng cần FCM hoặc máy chủ gửi push.</p>
                    </section>

                    <section class="section-card" id="weight-history-section">
                        <h3><i class="fa-solid fa-weight-scale"></i> Lịch sử cân nặng</h3>
                        <p class="subtitle">Ghi một số đo mỗi ngày. Lưu lại cùng ngày sẽ cập nhật số đo cũ.</p>
                        <form id="weight-entry-form" class="weight-entry-form">
                            <div class="input-field">
                                <label for="weight-entry-date">Ngày đo</label>
                                <input type="date" id="weight-entry-date" required>
                            </div>
                            <div class="input-field">
                                <label for="weight-entry-kg">Cân nặng (kg)</label>
                                <input type="number" id="weight-entry-kg" min="30" max="350" step="0.1" placeholder="70.0" required>
                            </div>
                            <button type="submit" class="btn btn-primary" id="save-weight-entry-btn">Lưu số đo</button>
                        </form>
                        <p id="weight-entry-status" class="auth-feedback" role="status" aria-live="polite"></p>
                        <div class="weight-summary-grid">
                            <div><span>Mới nhất</span><strong id="weight-latest">--</strong></div>
                            <div><span>Trung bình 7 ngày</span><strong id="weight-seven-day-average">--</strong></div>
                            <div><span>Tổng thay đổi</span><strong id="weight-total-change">--</strong></div>
                            <div><span>Trung bình/tuần</span><strong id="weight-weekly-rate">--</strong></div>
                            <div><span>Số lần đo</span><strong id="weight-entry-count">0</strong></div>
                            <div><span>Mục tiêu</span><strong id="weight-target">--</strong></div>
                            <div><span>Còn lại</span><strong id="weight-remaining">--</strong></div>
                            <div><span>Tiến độ mục tiêu</span><strong id="weight-progress-percent">--</strong></div>
                        </div>
                        <div class="goal-progress-track" aria-hidden="true"><div id="weight-goal-progress-bar"></div></div>
                        <p id="weight-progress-status" class="weight-progress-status" role="status">Thêm số đo để tính tiến độ mục tiêu.</p>
                        <div class="weight-chart-wrap">
                            <canvas id="weight-history-chart" width="900" height="320" role="img" aria-label="Biểu đồ tiến độ gồm cân nặng hằng ngày, trung bình 7 ngày và cân nặng mục tiêu">Dữ liệu chi tiết của biểu đồ có trong bảng lịch sử cân nặng bên dưới.</canvas>
                        </div>
                        <p class="subtitle">Trung bình 7 ngày sử dụng số đo của ngày hiện tại và 6 ngày trước đó. Kết quả xuất hiện khi có ít nhất 3 số đo trong khoảng này.</p>
                        <div class="weight-history-table-wrap">
                            <table class="weight-history-table">
                                <caption class="visually-hidden">Lịch sử số đo cân nặng</caption>
                                <thead><tr><th>Ngày</th><th>Cân nặng</th><th>Trung bình 7 ngày</th><th>Thay đổi</th></tr></thead>
                                <tbody id="weight-history-list"></tbody>
                            </table>
                        </div>
                    </section>

                    <section class="section-card" id="activity-history-section">
                        <h3><i class="fa-solid fa-person-walking"></i> Vận động hằng ngày</h3>
                        <p class="subtitle">Ghi số bước và số phút vận động cường độ vừa đến mạnh. FitAI cần ít nhất 4 ngày dữ liệu để ước tính mức vận động quan sát được.</p>
                        <form id="activity-entry-form" class="activity-entry-form">
                            <div class="input-field">
                                <label for="activity-entry-date">Ngày</label>
                                <input type="date" id="activity-entry-date" required>
                            </div>
                            <div class="input-field">
                                <label for="activity-entry-steps">Số bước chân</label>
                                <input type="number" id="activity-entry-steps" min="0" max="100000" step="1" placeholder="7500" required>
                            </div>
                            <div class="input-field">
                                <label for="activity-entry-minutes">Phút vận động</label>
                                <input type="number" id="activity-entry-minutes" min="0" max="1440" step="1" placeholder="30" required>
                            </div>
                            <button type="submit" class="btn btn-primary" id="save-activity-entry-btn">Lưu vận động</button>
                        </form>
                        <p id="activity-entry-status" class="auth-feedback" role="status" aria-live="polite"></p>
                        <div class="activity-summary-grid">
                            <div><span>Bước chân 7 ngày</span><strong id="activity-average-steps">--</strong></div>
                            <div><span>Phút vận động</span><strong id="activity-total-minutes">--</strong></div>
                            <div><span>Mức quan sát</span><strong id="activity-observed-level">--</strong></div>
                            <div><span>TDEE quan sát</span><strong id="activity-adjusted-tdee">--</strong></div>
                            <div><span>Độ tin cậy dữ liệu</span><strong id="activity-confidence">--</strong></div>
                        </div>
                        <div class="goal-progress-track"><div id="activity-guideline-progress"></div></div>
                        <p id="activity-guidance" class="weight-progress-status">Hãy ghi ít nhất 4 ngày trước khi so sánh vận động với hồ sơ.</p>
                        <div class="weight-history-table-wrap">
                            <table class="weight-history-table">
                                <caption class="visually-hidden">Lịch sử bước chân và phút vận động</caption>
                                <thead><tr><th>Ngày</th><th>Số bước</th><th>Phút vận động</th></tr></thead>
                                <tbody id="activity-history-list"></tbody>
                            </table>
                        </div>
                    </section>

                    <section class="section-card" id="wellness-history-section">
                        <h3><i class="fa-solid fa-moon"></i> Giấc ngủ và stress</h3>
                        <p class="subtitle">Theo dõi khả năng phục hồi mà không tự động thay đổi mục tiêu năng lượng.</p>
                        <form id="wellness-entry-form" class="wellness-entry-form">
                            <div class="input-field">
                                <label for="wellness-entry-date">Ngày</label>
                                <input type="date" id="wellness-entry-date" required>
                            </div>
                            <div class="input-field">
                                <label for="wellness-sleep-hours">Giấc ngủ (giờ)</label>
                                <input type="number" id="wellness-sleep-hours" min="0" max="24" step="0.1" placeholder="7.5" required>
                            </div>
                            <div class="input-field">
                                <label for="wellness-stress-level">Mức stress</label>
                                <select id="wellness-stress-level" required>
                                    <option value="1">1 — Rất thấp</option>
                                    <option value="2">2 — Thấp</option>
                                    <option value="3" selected>3 — Vừa</option>
                                    <option value="4">4 — Cao</option>
                                    <option value="5">5 — Rất cao</option>
                                </select>
                            </div>
                            <button type="submit" class="btn btn-primary" id="save-wellness-entry-btn">Lưu dữ liệu phục hồi</button>
                        </form>
                        <p id="wellness-entry-status" class="auth-feedback" role="status" aria-live="polite"></p>
                        <div class="wellness-summary-grid">
                            <div><span>Ngủ trung bình</span><strong id="wellness-average-sleep">--</strong></div>
                            <div><span>Stress trung bình</span><strong id="wellness-average-stress">--</strong></div>
                            <div><span>Đêm ngủ từ 7 giờ</span><strong id="wellness-sleep-goal-days">--</strong></div>
                            <div><span>Ngày stress cao</span><strong id="wellness-high-stress-days">--</strong></div>
                            <div><span>Số ngày đã ghi</span><strong id="wellness-sample-days">--</strong></div>
                        </div>
                        <p id="wellness-insight" class="wellness-insight" role="status">Hãy ghi ít nhất 4 ngày để nhận nhận xét về khả năng phục hồi.</p>
                        <div class="weight-history-table-wrap">
                            <table class="weight-history-table">
                                <caption class="visually-hidden">Lịch sử giấc ngủ và mức stress</caption>
                                <thead><tr><th>Ngày</th><th>Giấc ngủ</th><th>Stress</th></tr></thead>
                                <tbody id="wellness-history-list"></tbody>
                            </table>
                        </div>
                    </section>

                    <section class="section-card ai-assistant-chat-box" aria-labelledby="nutrition-chat-heading">
                        <h3 id="nutrition-chat-heading"><i class="fa-solid fa-robot" style="color:var(--primary-color);" aria-hidden="true"></i> Trợ lý dinh dưỡng AI</h3>
                        <p class="subtitle" style="margin-bottom:15px;">Hỏi về cách áp dụng mục tiêu năng lượng và macro của bạn. AI không thay thế bác sĩ và không tự thay đổi kế hoạch.</p>
                        <div class="chat-display-area" id="ai-chat-history" role="log" aria-live="polite" aria-relevant="additions" aria-label="Lịch sử trò chuyện">
                            <div class="ai-msg"><strong>FitAI:</strong> Bạn muốn được hỗ trợ gì về kế hoạch dinh dưỡng hôm nay?</div>
                        </div>
                        <form class="food-assistant-controls" id="nutrition-chat-form">
                            <label for="ai-chat-input" class="visually-hidden">Câu hỏi dinh dưỡng</label>
                            <textarea id="ai-chat-input" maxlength="600" rows="2" placeholder="Ví dụ: Hôm nay tôi còn thiếu bao nhiêu protein?"></textarea>
                            <button type="submit" class="btn btn-primary" id="ai-chat-send-btn">Gửi</button>
                        </form>
                        <p id="nutrition-chat-status" class="auth-feedback" role="status" aria-live="polite" hidden></p>
                    </section>
                </div>
            </div>
        </main>
        <%- include('../partials/bottom-nav', { activePage: 'profile' }) %>
    </div>
    <%- include('../partials/app-scripts', {
        extraScripts: ['activity-utils.js', 'wellness-utils.js', 'reminder-utils.js', 'weight-utils.js']
    }) %>
</body>
</html>
