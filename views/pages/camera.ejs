<%- include('../partials/head', { pageTitle: 'Nhận diện món ăn' }) %>
<body>
    <%- include('../partials/skip-link', { targetId: 'main-content' }) %>
    <div class="app-container">
        <%- include('../partials/app-header') %>
        <main class="app-main-content" id="main-content" tabindex="-1">
            <div class="content-max-width">
                <div class="page-header">
                    <h1>Nhận diện món ăn</h1>
                    <p class="subtitle">Tra cứu khẩu phần đã cân bằng dữ liệu thành phần thực phẩm USDA FoodData Central.</p>
                </div>
                <div class="section-card grid-2-columns camera-workspace">
                    <div class="upload-zone">
                        <section class="barcode-scanner" aria-labelledby="barcode-scanner-title">
                            <div class="camera-section-heading">
                                <span class="camera-step">01</span>
                                <div><h2 id="barcode-scanner-title">Sản phẩm có mã vạch?</h2><p class="subtitle">Quét bằng camera hoặc nhập UPC/EAN trên bao bì.</p></div>
                            </div>
                            <video id="barcode-video" playsinline muted aria-label="Khung hình quét mã vạch"></video>
                            <div class="camera-action-row">
                                <button type="button" class="btn btn-secondary" id="start-barcode-scan-btn"><i class="fa-solid fa-barcode" aria-hidden="true"></i> Quét mã</button>
                                <button type="button" class="btn btn-secondary" id="stop-barcode-scan-btn" hidden>Dừng quét</button>
                            </div>
                            <label for="barcode-input">Mã UPC/EAN</label>
                            <div class="barcode-entry-row">
                                <input id="barcode-input" type="text" inputmode="numeric" autocomplete="off" pattern="[0-9]*" maxlength="14" placeholder="Ví dụ: 049000050103">
                                <button type="button" class="btn btn-primary" id="lookup-barcode-btn">Tra mã</button>
                            </div>
                            <p id="barcode-status" class="camera-status" role="status" aria-live="polite"></p>
                            <p class="camera-help-text">Sản phẩm Việt Nam có thể chưa có trong USDA. Nếu không tìm thấy, hãy tra theo tên hoặc đối chiếu nhãn.</p>
                        </section>
                        <section class="photo-scanner" aria-labelledby="photo-scanner-title">
                            <div class="camera-section-heading">
                                <span class="camera-step">02</span>
                                <div><h2 id="photo-scanner-title">Món ăn không có mã vạch?</h2><p class="subtitle">Chụp ảnh hoặc chọn ảnh để AI gợi ý tên món.</p></div>
                            </div>
                            <input type="file" id="food-upload" accept="image/jpeg,image/png,image/webp,image/gif" hidden>
                            <input type="file" id="food-camera-capture" accept="image/jpeg,image/png,image/webp" capture="environment" hidden>
                            <div class="camera-action-row photo-action-row">
                                <button type="button" class="btn btn-primary" id="capture-image-btn"><i class="fa-solid fa-camera" aria-hidden="true"></i> Chụp ảnh</button>
                                <button type="button" class="btn btn-secondary" id="upload-image-btn"><i class="fa-regular fa-image" aria-hidden="true"></i> Chọn ảnh</button>
                            </div>
                            <img id="food-preview" alt="Ảnh xem trước món ăn" hidden>
                            <button type="button" class="btn btn-primary" id="analyze-photo-btn" disabled><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> Nhận diện món trong ảnh</button>
                            <p id="vision-status" class="camera-status" role="status" aria-live="polite"></p>
                            <a id="vision-signin-link" href="/profile" hidden>Đăng nhập để dùng tính năng nhận diện ảnh</a>
                            <label for="vision-food-candidates" id="vision-candidates-label" hidden>Chọn gợi ý phù hợp nhất</label>
                            <select id="vision-food-candidates" hidden></select>
                            <p id="vision-confidence" class="vision-confidence" role="status" hidden></p>
                            <button type="button" class="btn btn-secondary" id="confirm-food-candidate-btn" hidden>Xác nhận gợi ý này</button>
                            <p class="camera-help-text">AI chỉ gợi ý món nhìn thấy, không đo được khối lượng, dầu, nước sốt hoặc nguyên liệu bị che. Ảnh chỉ được gửi đi khi bạn bấm nhận diện.</p>
                        </section>
                        <section class="food-search" aria-labelledby="food-search-title">
                            <div class="camera-section-heading">
                                <span class="camera-step">03</span>
                                <div><h2 id="food-search-title">Kiểm tra dinh dưỡng</h2><p class="subtitle">Chọn đúng món và nhập khẩu phần đã cân để tra USDA.</p></div>
                            </div>
                            <label for="food-search-query">Tên món ăn</label>
                            <input id="food-search-query" type="search" inputmode="search" placeholder="Ví dụ: fried chicken" maxlength="100">
                            <div class="serving-search-row">
                                <div><label for="food-serving-grams">Khẩu phần (gram)</label><input id="food-serving-grams" type="number" min="1" max="2000" value="100"></div>
                                <button type="button" class="btn btn-primary" id="recognize-food-btn">Tra cứu USDA</button>
                            </div>
                            <p id="food-search-status" class="camera-status" role="status" aria-live="polite"></p>
                            <p class="camera-help-text">Giá trị dinh dưỡng là ước tính từ USDA. Hãy kiểm tra tên, khẩu phần và nhãn sản phẩm khi có.</p>
                        </section>
                    </div>
                    <div class="food-analysis" id="analysis-result" style="display:none; text-align:center; flex-direction:column; justify-content:center;">
                        <h4 style="color:#2ecc71;"><i class="fa-solid fa-database"></i> Kết quả dinh dưỡng</h4>
                        <div class="food-name" style="font-size: 22px; font-weight: bold; margin: 12px 0;" id="analysis-food-name">...</div>
                        <div class="nutrition-grid" style="display:flex; justify-content:center; gap:12px; flex-wrap:wrap; margin-bottom:12px;">
                            <div class="calorie-tag" style="background: rgba(46,204,113,0.15); color:#2ecc71; padding:6px 20px; border-radius:20px; font-weight:bold;">Năng lượng: <span id="analysis-calories">-- kcal</span></div>
                            <div class="calorie-tag" style="background: rgba(46,204,113,0.1); color:#2ecc71; padding:6px 20px; border-radius:20px; font-weight:bold;">Chất đạm: <span id="analysis-protein">-- g</span></div>
                            <div class="calorie-tag" style="background: rgba(46,204,113,0.1); color:#2ecc71; padding:6px 20px; border-radius:20px; font-weight:bold;">Tinh bột: <span id="analysis-carbs">-- g</span></div>
                            <div class="calorie-tag" style="background: rgba(46,204,113,0.1); color:#2ecc71; padding:6px 20px; border-radius:20px; font-weight:bold;">Chất béo: <span id="analysis-fat">-- g</span></div>
                            <div class="calorie-tag" style="background: rgba(46,204,113,0.1); color:#2ecc71; padding:6px 20px; border-radius:20px; font-weight:bold;">Chất xơ: <span id="analysis-fiber">-- g</span></div>
                        </div>
                        <p id="analysis-data-quality" class="data-quality-warning" role="status" hidden></p>
                        <div id="label-fiber-confirmation" class="data-quality-warning" hidden style="text-align:left; margin-top:10px;">
                            <label for="confirm-label-fiber-zero" style="display:flex; align-items:flex-start; gap:8px; cursor:pointer;">
                                <input id="confirm-label-fiber-zero" type="checkbox" style="margin-top:3px;">
                                <span>Tôi đã kiểm tra nhãn sản phẩm và xác nhận chất xơ là 0 g.</span>
                            </label>
                            <p class="subtitle" style="margin-top:6px;">Chỉ xác nhận khi nhãn thật sự ghi 0 g hoặc “not a significant source of dietary fiber”.</p>
                        </div>
                        <label for="food-result-select" style="font-weight:600;">Chọn kết quả gần đúng nhất</label>
                        <select id="food-result-select" style="width:100%; margin-top:8px;"></select>
                        <label for="food-portion-select" id="food-portion-label" hidden style="margin-top:12px; font-weight:600;">Chọn khẩu phần USDA</label>
                        <select id="food-portion-select" hidden style="width:100%; margin-top:8px;"></select>
                        <p id="analysis-source" class="subtitle" style="margin-top:10px;"></p>
                        <button class="btn btn-primary" id="add-food-btn" style="margin-top: 20px; width:100%;" disabled>+ Thêm vào nhật ký</button>
                    </div>
                </div>
            </div>
        </main>
        <%- include('../partials/bottom-nav', { activePage: 'camera' }) %>
    </div>
    <%- include('../partials/app-scripts', { extraScripts: ['image-utils.js'] }) %>
</body>
</html>
